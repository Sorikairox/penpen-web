/* SH-4 instruction encodings (our table, from the public SH-4 Software Manual).
 * I(name, pattern, kind): pattern is 16 characters, MSB first; 0/1 fixed bits, n/m register fields,
 * i immediate, d displacement. kind: OP = executed by op_<name>() in sh4_ops.h (interpreter and recompiled
 * code alike); BR = control transfer, handled separately by the interpreter and by the recompiler.
 * Read by sh4_interp.c (X-macro) and by port/recomp/recomp.py (regex): keep one entry per line. */

/* data transfer */
I(MOV_RR,      "0110nnnnmmmm0011", OP)
I(MOV_I,       "1110nnnniiiiiiii", OP)
I(MOVW_PC,     "1001nnnndddddddd", OP)
I(MOVL_PC,     "1101nnnndddddddd", OP)
I(MOVB_S,      "0010nnnnmmmm0000", OP)
I(MOVW_S,      "0010nnnnmmmm0001", OP)
I(MOVL_S,      "0010nnnnmmmm0010", OP)
I(MOVB_L,      "0110nnnnmmmm0000", OP)
I(MOVW_L,      "0110nnnnmmmm0001", OP)
I(MOVL_L,      "0110nnnnmmmm0010", OP)
I(MOVB_SDEC,   "0010nnnnmmmm0100", OP)
I(MOVW_SDEC,   "0010nnnnmmmm0101", OP)
I(MOVL_SDEC,   "0010nnnnmmmm0110", OP)
I(MOVB_LINC,   "0110nnnnmmmm0100", OP)
I(MOVW_LINC,   "0110nnnnmmmm0101", OP)
I(MOVL_LINC,   "0110nnnnmmmm0110", OP)
I(MOVB_S4,     "10000000nnnndddd", OP)
I(MOVW_S4,     "10000001nnnndddd", OP)
I(MOVL_S4,     "0001nnnnmmmmdddd", OP)
I(MOVB_L4,     "10000100mmmmdddd", OP)
I(MOVW_L4,     "10000101mmmmdddd", OP)
I(MOVL_L4,     "0101nnnnmmmmdddd", OP)
I(MOVB_S0,     "0000nnnnmmmm0100", OP)
I(MOVW_S0,     "0000nnnnmmmm0101", OP)
I(MOVL_S0,     "0000nnnnmmmm0110", OP)
I(MOVB_L0,     "0000nnnnmmmm1100", OP)
I(MOVW_L0,     "0000nnnnmmmm1101", OP)
I(MOVL_L0,     "0000nnnnmmmm1110", OP)
I(MOVB_SG,     "11000000dddddddd", OP)
I(MOVW_SG,     "11000001dddddddd", OP)
I(MOVL_SG,     "11000010dddddddd", OP)
I(MOVB_LG,     "11000100dddddddd", OP)
I(MOVW_LG,     "11000101dddddddd", OP)
I(MOVL_LG,     "11000110dddddddd", OP)
I(MOVA,        "11000111dddddddd", OP)
I(MOVT,        "0000nnnn00101001", OP)
I(SWAPB,       "0110nnnnmmmm1000", OP)
I(SWAPW,       "0110nnnnmmmm1001", OP)
I(XTRCT,       "0010nnnnmmmm1101", OP)
I(MOVCAL,      "0000nnnn11000011", OP)
/* arithmetic */
I(ADD,         "0011nnnnmmmm1100", OP)
I(ADD_I,       "0111nnnniiiiiiii", OP)
I(ADDC,        "0011nnnnmmmm1110", OP)
I(ADDV,        "0011nnnnmmmm1111", OP)
I(CMPEQ_I,     "10001000iiiiiiii", OP)
I(CMPEQ,       "0011nnnnmmmm0000", OP)
I(CMPHS,       "0011nnnnmmmm0010", OP)
I(CMPGE,       "0011nnnnmmmm0011", OP)
I(CMPHI,       "0011nnnnmmmm0110", OP)
I(CMPGT,       "0011nnnnmmmm0111", OP)
I(CMPPZ,       "0100nnnn00010001", OP)
I(CMPPL,       "0100nnnn00010101", OP)
I(CMPSTR,      "0010nnnnmmmm1100", OP)
I(DIV1,        "0011nnnnmmmm0100", OP)
I(DIV0S,       "0010nnnnmmmm0111", OP)
I(DIV0U,       "0000000000011001", OP)
I(DMULS,       "0011nnnnmmmm1101", OP)
I(DMULU,       "0011nnnnmmmm0101", OP)
I(DT,          "0100nnnn00010000", OP)
I(EXTSB,       "0110nnnnmmmm1110", OP)
I(EXTSW,       "0110nnnnmmmm1111", OP)
I(EXTUB,       "0110nnnnmmmm1100", OP)
I(EXTUW,       "0110nnnnmmmm1101", OP)
I(MACL,        "0000nnnnmmmm1111", OP)
I(MACW,        "0100nnnnmmmm1111", OP)
I(MULL,        "0000nnnnmmmm0111", OP)
I(MULSW,       "0010nnnnmmmm1111", OP)
I(MULUW,       "0010nnnnmmmm1110", OP)
I(NEG,         "0110nnnnmmmm1011", OP)
I(NEGC,        "0110nnnnmmmm1010", OP)
I(SUB,         "0011nnnnmmmm1000", OP)
I(SUBC,        "0011nnnnmmmm1010", OP)
I(SUBV,        "0011nnnnmmmm1011", OP)
/* logic */
I(AND,         "0010nnnnmmmm1001", OP)
I(AND_I,       "11001001iiiiiiii", OP)
I(ANDB,        "11001101iiiiiiii", OP)
I(NOT,         "0110nnnnmmmm0111", OP)
I(OR,          "0010nnnnmmmm1011", OP)
I(OR_I,        "11001011iiiiiiii", OP)
I(ORB,         "11001111iiiiiiii", OP)
I(TASB,        "0100nnnn00011011", OP)
I(TST,         "0010nnnnmmmm1000", OP)
I(TST_I,       "11001000iiiiiiii", OP)
I(TSTB,        "11001100iiiiiiii", OP)
I(XOR,         "0010nnnnmmmm1010", OP)
I(XOR_I,       "11001010iiiiiiii", OP)
I(XORB,        "11001110iiiiiiii", OP)
/* shifts */
I(ROTL,        "0100nnnn00000100", OP)
I(ROTR,        "0100nnnn00000101", OP)
I(ROTCL,       "0100nnnn00100100", OP)
I(ROTCR,       "0100nnnn00100101", OP)
I(SHAD,        "0100nnnnmmmm1100", OP)
I(SHAL,        "0100nnnn00100000", OP)
I(SHAR,        "0100nnnn00100001", OP)
I(SHLD,        "0100nnnnmmmm1101", OP)
I(SHLL,        "0100nnnn00000000", OP)
I(SHLR,        "0100nnnn00000001", OP)
I(SHLL2,       "0100nnnn00001000", OP)
I(SHLR2,       "0100nnnn00001001", OP)
I(SHLL8,       "0100nnnn00011000", OP)
I(SHLR8,       "0100nnnn00011001", OP)
I(SHLL16,      "0100nnnn00101000", OP)
I(SHLR16,      "0100nnnn00101001", OP)
/* branches */
I(BF,          "10001011dddddddd", BR)
I(BFS,         "10001111dddddddd", BR)
I(BT,          "10001001dddddddd", BR)
I(BTS,         "10001101dddddddd", BR)
I(BRA,         "1010dddddddddddd", BR)
I(BRAF,        "0000nnnn00100011", BR)
I(BSR,         "1011dddddddddddd", BR)
I(BSRF,        "0000nnnn00000011", BR)
I(JMP,         "0100nnnn00101011", BR)
I(JSR,         "0100nnnn00001011", BR)
I(RTS,         "0000000000001011", BR)
I(RTE,         "0000000000101011", BR)
I(TRAPA,       "11000011iiiiiiii", BR)
I(SLEEP,       "0000000000011011", BR)
I(LDTLB,       "0000000000111000", BR)
/* system */
I(CLRMAC,      "0000000000101000", OP)
I(CLRS,        "0000000001001000", OP)
I(CLRT,        "0000000000001000", OP)
I(SETS,        "0000000001011000", OP)
I(SETT,        "0000000000011000", OP)
I(NOP,         "0000000000001001", OP)
I(OCBI,        "0000nnnn10010011", OP)
I(OCBP,        "0000nnnn10100011", OP)
I(OCBWB,       "0000nnnn10110011", OP)
I(PREF,        "0000nnnn10000011", OP)
I(LDC_SR,      "0100mmmm00001110", OP)
I(LDC_GBR,     "0100mmmm00011110", OP)
I(LDC_VBR,     "0100mmmm00101110", OP)
I(LDC_SSR,     "0100mmmm00111110", OP)
I(LDC_SPC,     "0100mmmm01001110", OP)
I(LDC_DBR,     "0100mmmm11111010", OP)
I(LDC_BANK,    "0100mmmm1nnn1110", OP)
I(LDCL_SR,     "0100mmmm00000111", OP)
I(LDCL_GBR,    "0100mmmm00010111", OP)
I(LDCL_VBR,    "0100mmmm00100111", OP)
I(LDCL_SSR,    "0100mmmm00110111", OP)
I(LDCL_SPC,    "0100mmmm01000111", OP)
I(LDCL_DBR,    "0100mmmm11110110", OP)
I(LDCL_BANK,   "0100mmmm1nnn0111", OP)
I(LDS_MACH,    "0100mmmm00001010", OP)
I(LDS_MACL,    "0100mmmm00011010", OP)
I(LDS_PR,      "0100mmmm00101010", OP)
I(LDSL_MACH,   "0100mmmm00000110", OP)
I(LDSL_MACL,   "0100mmmm00010110", OP)
I(LDSL_PR,     "0100mmmm00100110", OP)
I(STC_SR,      "0000nnnn00000010", OP)
I(STC_GBR,     "0000nnnn00010010", OP)
I(STC_VBR,     "0000nnnn00100010", OP)
I(STC_SSR,     "0000nnnn00110010", OP)
I(STC_SPC,     "0000nnnn01000010", OP)
I(STC_SGR,     "0000nnnn00111010", OP)
I(STC_DBR,     "0000nnnn11111010", OP)
I(STC_BANK,    "0000nnnn1mmm0010", OP)
I(STCL_SR,     "0100nnnn00000011", OP)
I(STCL_GBR,    "0100nnnn00010011", OP)
I(STCL_VBR,    "0100nnnn00100011", OP)
I(STCL_SSR,    "0100nnnn00110011", OP)
I(STCL_SPC,    "0100nnnn01000011", OP)
I(STCL_SGR,    "0100nnnn00110010", OP)
I(STCL_DBR,    "0100nnnn11110010", OP)
I(STCL_BANK,   "0100nnnn1mmm0011", OP)
I(STS_MACH,    "0000nnnn00001010", OP)
I(STS_MACL,    "0000nnnn00011010", OP)
I(STS_PR,      "0000nnnn00101010", OP)
I(STSL_MACH,   "0100nnnn00000010", OP)
I(STSL_MACL,   "0100nnnn00010010", OP)
I(STSL_PR,     "0100nnnn00100010", OP)
/* FPU (SZ and PR select the single/double/pair forms at run time) */
I(FMOV,        "1111nnnnmmmm1100", OP)
I(FMOV_L,      "1111nnnnmmmm1000", OP)
I(FMOV_S,      "1111nnnnmmmm1010", OP)
I(FMOV_LINC,   "1111nnnnmmmm1001", OP)
I(FMOV_SDEC,   "1111nnnnmmmm1011", OP)
I(FMOV_L0,     "1111nnnnmmmm0110", OP)
I(FMOV_S0,     "1111nnnnmmmm0111", OP)
I(FLDI0,       "1111nnnn10001101", OP)
I(FLDI1,       "1111nnnn10011101", OP)
I(FLDS,        "1111mmmm00011101", OP)
I(FSTS,        "1111nnnn00001101", OP)
I(FABS,        "1111nnnn01011101", OP)
I(FNEG,        "1111nnnn01001101", OP)
I(FADD,        "1111nnnnmmmm0000", OP)
I(FSUB,        "1111nnnnmmmm0001", OP)
I(FMUL,        "1111nnnnmmmm0010", OP)
I(FDIV,        "1111nnnnmmmm0011", OP)
I(FCMPEQ,      "1111nnnnmmmm0100", OP)
I(FCMPGT,      "1111nnnnmmmm0101", OP)
I(FLOAT,       "1111nnnn00101101", OP)
I(FTRC,        "1111mmmm00111101", OP)
I(FMAC,        "1111nnnnmmmm1110", OP)
I(FSQRT,       "1111nnnn01101101", OP)
I(FSRRA,       "1111nnnn01111101", OP)
I(FCNVDS,      "1111mmm010111101", OP)
I(FCNVSD,      "1111nnn010101101", OP)
I(FIPR,        "1111nnmm11101101", OP)
I(FTRV,        "1111nn0111111101", OP)
I(FSCA,        "1111nnn011111101", OP)
I(FRCHG,       "1111101111111101", OP)
I(FSCHG,       "1111001111111101", OP)
I(LDS_FPSCR,   "0100mmmm01101010", OP)
I(LDS_FPUL,    "0100mmmm01011010", OP)
I(LDSL_FPSCR,  "0100mmmm01100110", OP)
I(LDSL_FPUL,   "0100mmmm01010110", OP)
I(STS_FPSCR,   "0000nnnn01101010", OP)
I(STS_FPUL,    "0000nnnn01011010", OP)
I(STSL_FPSCR,  "0100nnnn01100010", OP)
I(STSL_FPUL,   "0100nnnn01010010", OP)
